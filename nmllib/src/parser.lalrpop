KBaseGraphics = "base_graphics";
KRecolourSprite = "recolour_sprite";
KEngineOverride = "engine_override";
KSort = "sort";
KConst = "const";

Translation: Translation = {
    Literal => Translation::Literal(<>),
    "string" LParen <id: Id> RParen => {
        Translation::Id(id)
    }
}

